# Local builds (including backups created after moving the project)
/build*/

# Python caches and environments
__pycache__/
*.pyc
.venv/
venv/

# Generated simulations and validation artifacts; retain scripts and JSON summaries
/runs/
/local_chinese/
/local_development/
/validation/*/
/validation/*.log

# Multi-fidelity release outputs and external datasets
/output/
/external_data/
/meshes/
*.bin
*.cgns
*.tgz
*.tar.gz
*.npy
*.npz
!examples/**/*.npz

# Local credentials and agent settings
.env
.env.*
!.env.example
/.aws/
/.agents/
/.codex/

# Editor and operating-system files
.DS_Store
Thumbs.db
